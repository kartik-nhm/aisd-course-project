# ==============================================================================
# SMART TELEHEALTH PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform Core (Node.js Express API & STOMP Signaling)
# ------------------------------------------------------------------------------
PORT=8080
CORS_ORIGIN=*
MONGO_URI=mongodb://localhost:27017/smart_telehealth
JWT_SECRET=super_secure_jwt_secret_change_in_production
JWT_EXPIRATION_HOURS=24

# Resend API (OTP Authentication & Pharmacy Surge Advisory Emails)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_SENDER_EMAIL=alerts@telehealth.local

# ------------------------------------------------------------------------------
# 2. AI & Clinical Extraction Pipeline (AssemblyAI & Google Gemini)
# ------------------------------------------------------------------------------
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com/v2

GOOGLE_API_KEY=your_google_genai_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. Multilingual RAG Assistant (FastAPI Microservice)
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# Pinecone Vector Store
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=medical-knowledge-base
PINECONE_ENVIRONMENT=us-east-1

# Groq LLaMA (Fast Translation & Language Detection)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_COMPLEX_MODEL=llama-3.3-70b-versatile

# HuggingFace Embeddings
EMBEDDING_MODEL_NAME=intfloat/e5-base-v2

# ------------------------------------------------------------------------------
# 4. Regional Pharmacy Alert Settings
# ------------------------------------------------------------------------------
PHARMACY_SURGE_THRESHOLD=5
PHARMACY_SURGE_WINDOW_HOURS=24
PHARMACY_ALERT_EMAIL_ENABLED=true

# ------------------------------------------------------------------------------
# 5. Frontend & Jitsi WebRTC Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AI_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8080/telehealth-ws
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
